[Unit]
Description=Telegram Notification Bridge for PC Desktop Notifications
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /home/paulobot/.local/bin/telegram-notify-bridge.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
