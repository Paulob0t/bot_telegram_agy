[Unit]
Description=HyprAgent — AGY & Claude Core (Tailscale WebSocket & Bot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/mnt/datos/Projects/telegram-paulobot/telegram-bot
WorkingDirectory=/mnt/datos/Projects/telegram-paulobot
Restart=always
RestartSec=3
MemoryHigh=600M
MemoryMax=1200M
OOMPolicy=continue
Environment=PATH=/home/paulobot/.local/bin:/home/paulobot/.gemini/antigravity-cli/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/paulobot
EnvironmentFile=-/mnt/datos/Projects/telegram-paulobot/.env
StandardOutput=append:/home/paulobot/.local/state/telegram-bot.log
StandardError=append:/home/paulobot/.local/state/telegram-bot.log

[Install]
WantedBy=default.target
