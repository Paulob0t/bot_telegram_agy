#!/usr/bin/env python3
"""
Hook Stop para Claude Code: envía notificación a Telegram y escritorio (Omarchy)
con 0 consumo de tokens (lee directamente el transcript .jsonl local).
"""
import json
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from notify_common import (  # noqa: E402
    format_full_response,
    send_desktop_check,
    send_telegram,
    shorten_title,
)


def extract_claude_transcript(transcript_path: str):
    user_task = ""
    last_response = ""
    if not transcript_path or not os.path.exists(transcript_path):
        return "", ""

    try:
        with open(transcript_path, "r", encoding="utf-8") as f:
            for line in f:
                if not line.strip():
                    continue
                try:
                    data = json.loads(line)
                    t = data.get("type")
                    if t == "user" and not data.get("isMeta"):
                        msg = data.get("message", {})
                        content = msg.get("content")
                        if isinstance(content, str):
                            clean = re.sub(r"<[^>]+>.*?</[^>]+>", "", content, flags=re.DOTALL).strip()
                            if clean and not clean.startswith("/"):
                                user_task = clean
                    elif t == "assistant":
                        msg = data.get("message", {})
                        content = msg.get("content")
                        if isinstance(content, list):
                            texts = [
                                item.get("text", "")
                                for item in content
                                if isinstance(item, dict) and item.get("type") == "text"
                            ]
                            joined = "\n".join(t for t in texts if t.strip()).strip()
                            if joined:
                                last_response = joined
                except Exception:
                    pass
    except Exception:
        pass

    return shorten_title(user_task), last_response


def main():
    if os.environ.get("CLAUDE_FROM_TELEGRAM") == "1":
        return

    try:
        raw_input = sys.stdin.read()
        payload = json.loads(raw_input) if raw_input.strip() else {}
        if payload.get("stop_hook_active"):
            return

        transcript_path = payload.get("transcript_path") or payload.get("transcriptPath") or ""
        cwd = payload.get("cwd") or os.getcwd()
        ws_name = os.path.basename(cwd.rstrip("/")) or "Stover"

        task_title, raw_response = extract_claude_transcript(transcript_path)
        if not task_title:
            task_title = "Tarea Claude lista"

        # 1. Notificación de escritorio (Omarchy: solo check + proyecto)
        send_desktop_check("Claude", ws_name)

        # 2. Notificación de Telegram con el desglose completo (0 tokens)
        full_body = format_full_response(raw_response)
        msg_lines = [f"✓ *[Claude] {task_title}* · `{ws_name}`"]
        if full_body:
            msg_lines.append("")
            msg_lines.append(full_body)
        send_telegram("\n".join(msg_lines))
    except Exception:
        pass


if __name__ == "__main__":
    main()
