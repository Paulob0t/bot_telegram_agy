#!/usr/bin/env python3
"""
Hook Stop para Claude Code: envía notificación a Telegram y escritorio (Omarchy)
con 0 consumo de tokens (lee directamente el transcript .jsonl local).
En Telegram envía el desglose exacto que respondió Claude.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.parse
import urllib.request

TITLE_MAX = 50
DESKTOP_SUMMARY_MAX = 90
TELEGRAM_BODY_MAX = 3500


def _load_env():
    for p in (
        "/run/media/paulobot/Datos/Projects/telegram-paulobot/.env",
        os.path.expanduser("~/.config/telegram-bot/.env"),
    ):
        if os.path.isfile(p):
            try:
                with open(p, "r", encoding="utf-8") as f:
                    for raw in f:
                        line = raw.strip()
                        if line and not line.startswith("#") and "=" in line:
                            k, v = line.split("=", 1)
                            os.environ.setdefault(k.strip(), v.strip().strip('"').strip("'"))
            except Exception:
                pass


_load_env()
TOKEN = os.environ.get("TELEGRAM_BOT_TOKEN", "").strip()
CHAT_ID = os.environ.get("TELEGRAM_CHAT_ID", os.environ.get("TELEGRAM_AUTHORIZED_USER_ID", "")).strip()


def _clip(text: str, limit: int) -> str:
    if len(text) <= limit:
        return text
    cut = text[:limit].rsplit(" ", 1)[0]
    return cut.rstrip(" ,;:.") + "…"


def shorten_title(user_task: str) -> str:
    text = re.sub(r"<[^>]+>", "", user_task or "").strip()
    first = text.split("\n")[0].strip() if text else ""
    return _clip(first, TITLE_MAX)


def format_full_response(response: str) -> str:
    """Devuelve el desglose exacto del modelo, convirtiendo links file:// a código legible."""
    if not response:
        return ""
    text = response.strip()
    text = re.sub(r"\[`?([^\]`]+)`?\]\(file://[^\)]+\)", r"`\1`", text)
    return _clip(text, TELEGRAM_BODY_MAX)


def shorten_desktop_summary(response: str) -> str:
    desc = response or ""
    desc = re.sub(r"```.*?```", "", desc, flags=re.DOTALL)
    desc = re.sub(r"`([^`]+)`", r"\1", desc)
    desc = re.sub(r"\[([^\]]+)\]\([^\)]+\)", r"\1", desc)
    desc = re.sub(r"[#*>_|]", "", desc)
    lines = [l.strip(" -•\t") for l in desc.splitlines()]
    lines = [l for l in lines if len(l) > 2 and set(l) - set("-=")]
    first = lines[0] if lines else ""
    first = re.split(r"(?<=[.!?])\s", first, maxsplit=1)[0]
    return _clip(" ".join(first.split()), DESKTOP_SUMMARY_MAX)


def extract_claude_transcript(transcript_path: str):
    user_task = ""
    last_response = ""
    if not transcript_path or not os.path.exists(transcript_path):
        return "", ""

    try:
        with open(transcript_path, "r", encoding="utf-8") as f:
            for line in f:
                if not line.strip():
                    continue
                try:
                    data = json.loads(line)
                    t = data.get("type")
                    if t == "user" and not data.get("isMeta"):
                        msg = data.get("message", {})
                        content = msg.get("content")
                        if isinstance(content, str):
                            clean = re.sub(r"<[^>]+>.*?</[^>]+>", "", content, flags=re.DOTALL).strip()
                            if clean and not clean.startswith("/"):
                                user_task = clean
                    elif t == "assistant":
                        msg = data.get("message", {})
                        content = msg.get("content")
                        if isinstance(content, list):
                            texts = [
                                item.get("text", "")
                                for item in content
                                if isinstance(item, dict) and item.get("type") == "text"
                            ]
                            joined = "\n".join(t for t in texts if t.strip()).strip()
                            if joined:
                                last_response = joined
                except Exception:
                    pass
    except Exception:
        pass

    return shorten_title(user_task), last_response


def send_telegram(text: str):
    if not TOKEN or not CHAT_ID:
        return
    url = f"https://api.telegram.org/bot{TOKEN}/sendMessage"
    payload = {
        "chat_id": CHAT_ID,
        "text": text[:4000],
        "parse_mode": "Markdown",
    }
    try:
        data = urllib.parse.urlencode(payload).encode("utf-8")
        req = urllib.request.Request(url, data=data)
        urllib.request.urlopen(req, timeout=5)
    except Exception:
        try:
            payload.pop("parse_mode", None)
            data = urllib.parse.urlencode(payload).encode("utf-8")
            req = urllib.request.Request(url, data=data)
            urllib.request.urlopen(req, timeout=5)
        except Exception:
            pass


def send_desktop(title: str, desc: str):
    if shutil.which("omarchy-notification-send"):
        cmd = ["omarchy-notification-send", "--app-name", "Claude", "-g", "✓", "-u", "normal", "-t", "6000", title]
        if desc:
            cmd.append(desc)
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif shutil.which("notify-send"):
        cmd = ["notify-send", "-a", "Claude", "-u", "normal", f"✓ {title}"]
        if desc:
            cmd.append(desc)
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    try:
        raw_input = sys.stdin.read()
        payload = json.loads(raw_input) if raw_input.strip() else {}
        if payload.get("stop_hook_active"):
            return

        transcript_path = payload.get("transcript_path") or payload.get("transcriptPath") or ""
        cwd = payload.get("cwd") or os.getcwd()
        ws_name = os.path.basename(cwd.rstrip("/")) or "Stover"

        task_title, raw_response = extract_claude_transcript(transcript_path)
        if not task_title:
            task_title = "Tarea Claude lista"

        desktop_desc = shorten_desktop_summary(raw_response)
        full_body = format_full_response(raw_response)

        # 1. Notificación de escritorio (Omarchy)
        send_desktop(task_title, desktop_desc)

        # 2. Notificación de Telegram con el desglose completo (0 tokens)
        msg_lines = [f"✓ *[Claude] {task_title}* · `{ws_name}`"]
        if full_body:
            msg_lines.append("")
            msg_lines.append(full_body)
        send_telegram("\n".join(msg_lines))
    except Exception:
        pass


if __name__ == "__main__":
    main()
