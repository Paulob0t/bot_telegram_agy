#!/usr/bin/env python3
"""
Hook Stop para Antigravity (AGY): envía notificación a Telegram y escritorio (Omarchy)
con 0 consumo de tokens (lee directamente el transcript .jsonl local).
"""
import json
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from notify_common import (  # noqa: E402
    clip,
    format_full_response,
    send_desktop_check,
    send_telegram,
    shorten_title,
)


def extract_agy_transcript(transcript_path: str):
    user_task = ""
    last_response = ""
    if not transcript_path or not os.path.exists(transcript_path):
        return "", ""

    try:
        with open(transcript_path, "r", encoding="utf-8") as f:
            for line in f:
                if not line.strip():
                    continue
                try:
                    data = json.loads(line)
                    t = data.get("type")
                    if t == "USER_INPUT":
                        content = data.get("content", "")
                        m = re.search(r"<USER_REQUEST>(.*?)</USER_REQUEST>", content, re.DOTALL)
                        user_task = m.group(1).strip() if m else content.strip()
                    elif t == "PLANNER_RESPONSE":
                        content = data.get("content")
                        if content and content.strip():
                            last_response = content.strip()
                except Exception:
                    pass
    except Exception:
        pass

    return shorten_title(user_task), last_response


def main():
    try:
        raw_input = sys.stdin.read()
        if not raw_input.strip():
            print(json.dumps({}))
            return

        payload = json.loads(raw_input)
        error = payload.get("error", "")
        workspaces = payload.get("workspacePaths", [])
        transcript_path = payload.get("transcriptPath", "")

        ws_name = os.path.basename(workspaces[0].rstrip("/\\")) if workspaces else "Workspace"
        task_title, raw_response = extract_agy_transcript(transcript_path)
        if not task_title:
            task_title = "Tarea finalizada"

        # 1. Notificación de escritorio (0 tokens, solo check + proyecto)
        send_desktop_check("Antigravity", ws_name)

        # 2. Notificación de Telegram con desglose completo (solo cuando trabajas en terminal/IDE)
        if os.environ.get("AGY_FROM_TELEGRAM") != "1":
            full_body = format_full_response(raw_response)
            icon = "⚠️" if error else "✓"
            msg_lines = [f"{icon} *[AGY] {task_title}* · `{ws_name}`"]
            if full_body:
                msg_lines.append("")
                msg_lines.append(full_body)
            if error:
                msg_lines.append(f"\n`{clip(str(error), 120)}`")
            send_telegram("\n".join(msg_lines))

    except Exception:
        pass

    print(json.dumps({}))


if __name__ == "__main__":
    main()
