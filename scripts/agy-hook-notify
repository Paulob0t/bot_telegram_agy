#!/usr/bin/env python3
"""
Hook Stop para Antigravity (AGY): envía notificación a Telegram y escritorio (Omarchy)
con 0 consumo de tokens (lee directamente el transcript .jsonl local).
En Telegram envía el desglose exacto que respondió AGY (limpiando links file://).
"""
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.parse
import urllib.request

TITLE_MAX = 50
DESKTOP_SUMMARY_MAX = 90
TELEGRAM_BODY_MAX = 3500


def _load_env():
    for p in (
        "/run/media/paulobot/Datos/Projects/telegram-paulobot/.env",
        os.path.expanduser("~/.config/telegram-bot/.env"),
    ):
        if os.path.isfile(p):
            try:
                with open(p, "r", encoding="utf-8") as f:
                    for raw in f:
                        line = raw.strip()
                        if line and not line.startswith("#") and "=" in line:
                            k, v = line.split("=", 1)
                            os.environ.setdefault(k.strip(), v.strip().strip('"').strip("'"))
            except Exception:
                pass


_load_env()
TOKEN = os.environ.get("TELEGRAM_BOT_TOKEN", "").strip()
CHAT_ID = os.environ.get("TELEGRAM_CHAT_ID", os.environ.get("TELEGRAM_AUTHORIZED_USER_ID", "")).strip()


def _clip(text: str, limit: int) -> str:
    if len(text) <= limit:
        return text
    cut = text[:limit].rsplit(" ", 1)[0]
    return cut.rstrip(" ,;:.") + "…"


def shorten_title(user_task: str) -> str:
    user_task = re.sub(r"<[^>]+>", "", user_task or "").strip()
    first = user_task.split("\n")[0].strip() if user_task else ""
    return _clip(first, TITLE_MAX)


def format_full_response(response: str) -> str:
    """Devuelve el desglose exacto del modelo, convirtiendo links file:// a código legible."""
    if not response:
        return ""
    text = response.strip()
    # Convierte [archivo.py](file:///ruta/...) -> `archivo.py`
    text = re.sub(r"\[`?([^\]`]+)`?\]\(file://[^\)]+\)", r"`\1`", text)
    text = re.sub(r"\[([^\]]+)\]\(conversation://[^\)]+\)", r"`\1`", text)
    return _clip(text, TELEGRAM_BODY_MAX)


def shorten_desktop_summary(response: str) -> str:
    desc = response or ""
    desc = re.sub(r"```.*?```", "", desc, flags=re.DOTALL)
    desc = re.sub(r"`([^`]+)`", r"\1", desc)
    desc = re.sub(r"\[([^\]]+)\]\([^\)]+\)", r"\1", desc)
    desc = re.sub(r"[#*>_|]", "", desc)
    lines = [l.strip(" -•\t") for l in desc.splitlines()]
    lines = [l for l in lines if len(l) > 2 and set(l) - set("-=")]
    first = lines[0] if lines else ""
    first = re.split(r"(?<=[.!?])\s", first, maxsplit=1)[0]
    return _clip(" ".join(first.split()), DESKTOP_SUMMARY_MAX)


def extract_agy_transcript(transcript_path: str):
    user_task = ""
    last_response = ""
    if not transcript_path or not os.path.exists(transcript_path):
        return "", ""

    try:
        with open(transcript_path, "r", encoding="utf-8") as f:
            for line in f:
                if not line.strip():
                    continue
                try:
                    data = json.loads(line)
                    t = data.get("type")
                    if t == "USER_INPUT":
                        content = data.get("content", "")
                        m = re.search(r"<USER_REQUEST>(.*?)</USER_REQUEST>", content, re.DOTALL)
                        user_task = m.group(1).strip() if m else content.strip()
                    elif t == "PLANNER_RESPONSE":
                        content = data.get("content")
                        if content and content.strip():
                            last_response = content.strip()
                except Exception:
                    pass
    except Exception:
        pass

    return shorten_title(user_task), last_response


def send_desktop(ws_name: str):
    title = f"Tarea lista · {ws_name}" if ws_name else "Tarea lista"
    if shutil.which("omarchy-notification-send"):
        subprocess.run(
            ["omarchy-notification-send", "--app-name", "Antigravity", "-g", "✓", "-u", "normal", "-t", "4000", title],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    elif shutil.which("notify-send"):
        subprocess.run(
            ["notify-send", "-a", "Antigravity", "-u", "normal", f"✓ {title}"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


def send_telegram(text: str):
    if not TOKEN or not CHAT_ID:
        return
    url = f"https://api.telegram.org/bot{TOKEN}/sendMessage"
    payload = {
        "chat_id": CHAT_ID,
        "text": text[:4000],
        "parse_mode": "Markdown",
    }
    try:
        data = urllib.parse.urlencode(payload).encode("utf-8")
        req = urllib.request.Request(url, data=data)
        urllib.request.urlopen(req, timeout=5)
    except Exception:
        try:
            payload.pop("parse_mode", None)
            data = urllib.parse.urlencode(payload).encode("utf-8")
            req = urllib.request.Request(url, data=data)
            urllib.request.urlopen(req, timeout=5)
        except Exception:
            pass


def main():
    try:
        raw_input = sys.stdin.read()
        if not raw_input.strip():
            print(json.dumps({}))
            return

        payload = json.loads(raw_input)
        error = payload.get("error", "")
        workspaces = payload.get("workspacePaths", [])
        transcript_path = payload.get("transcriptPath", "")

        ws_name = os.path.basename(workspaces[0].rstrip("/")) if workspaces else "Workspace"
        task_title, raw_response = extract_agy_transcript(transcript_path)
        if not task_title:
            task_title = "Tarea finalizada"

        full_body = format_full_response(raw_response)

        # 1. Notificación de escritorio (0 tokens, solo check + proyecto)
        send_desktop(ws_name)

        # 2. Notificación de Telegram (solo cuando trabajas en terminal/IDE; si ya estás en el bot, el bot envía la respuesta)
        if os.environ.get("AGY_FROM_TELEGRAM") != "1":
            icon = "⚠️" if error else "✓"
            msg_lines = [f"{icon} *[AGY] {task_title}* · `{ws_name}`"]
            if full_body:
                msg_lines.append("")
                msg_lines.append(full_body)
            if error:
                msg_lines.append(f"\n`{_clip(str(error), 120)}`")
            send_telegram("\n".join(msg_lines))

    except Exception:
        pass

    print(json.dumps({}))


if __name__ == "__main__":
    main()
