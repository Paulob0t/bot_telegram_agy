#!/usr/bin/env python3
"""
notify-telegram: Envía notificaciones a tu bot de Telegram desde la terminal o scripts.
Uso:
  notify-telegram "Mensaje a enviar"
  notify-telegram "Título" "Cuerpo del mensaje"
  echo "Salida de comando" | notify-telegram "Título"
"""

import sys
import os
import urllib.request
import urllib.parse
import json

def _load_env():
    for p in (
        "/run/media/paulobot/Datos/Projects/telegram-paulobot/.env",
        os.path.expanduser("~/.config/telegram-bot/.env"),
    ):
        if os.path.isfile(p):
            try:
                with open(p, "r", encoding="utf-8") as f:
                    for raw in f:
                        line = raw.strip()
                        if line and not line.startswith("#") and "=" in line:
                            k, v = line.split("=", 1)
                            os.environ.setdefault(k.strip(), v.strip().strip('"').strip("'"))
            except Exception:
                pass

_load_env()
TOKEN = os.getenv("TELEGRAM_BOT_TOKEN", "").strip()
CHAT_ID = os.getenv("TELEGRAM_CHAT_ID", os.getenv("TELEGRAM_AUTHORIZED_USER_ID", "")).strip()

def send_telegram(text: str, parse_mode: str = "Markdown") -> bool:
    if not TOKEN or not CHAT_ID:
        print("Error: TOKEN o CHAT_ID no configurados.", file=sys.stderr)
        return False

    url = f"https://api.telegram.org/bot{TOKEN}/sendMessage"
    payload = {
        "chat_id": CHAT_ID,
        "text": text[:4000],  # Límite seguro de Telegram
        "parse_mode": parse_mode
    }
    
    try:
        data = urllib.parse.urlencode(payload).encode("utf-8")
        req = urllib.request.Request(url, data=data)
        with urllib.request.urlopen(req, timeout=10) as resp:
            return resp.status == 200
    except Exception:
        # Fallback sin markdown en caso de caracteres especiales sin escapar
        try:
            payload.pop("parse_mode", None)
            data = urllib.parse.urlencode(payload).encode("utf-8")
            req = urllib.request.Request(url, data=data)
            with urllib.request.urlopen(req, timeout=10) as resp:
                return resp.status == 200
        except Exception as err:
            print(f"Error enviando mensaje a Telegram: {err}", file=sys.stderr)
            return False

def main():
    args = sys.argv[1:]
    stdin_content = ""

    # Si hay contenido en stdin (pipe)
    if not sys.stdin.isatty():
        try:
            stdin_content = sys.stdin.read().strip()
        except Exception:
            pass

    if len(args) == 0 and not stdin_content:
        print("Uso: notify-telegram [titulo] [mensaje]")
        print("      comando | notify-telegram [titulo]")
        sys.exit(1)

    if len(args) == 1:
        if stdin_content:
            title = args[0]
            message = f"🔔 *{title}*\n\n```\n{stdin_content[:3500]}\n```"
        else:
            message = f"🔔 {args[0]}"
    elif len(args) >= 2:
        title = args[0]
        body = " ".join(args[1:])
        if stdin_content:
            body += f"\n\n```\n{stdin_content[:3000]}\n```"
        message = f"🔔 *{title}*\n\n{body}"
    else:
        message = f"🔔 *Notificación de PC:*\n\n```\n{stdin_content[:3800]}\n```"

    success = send_telegram(message)
    sys.exit(0 if success else 1)

if __name__ == "__main__":
    main()
