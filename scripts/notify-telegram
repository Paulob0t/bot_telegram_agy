#!/usr/bin/env python3
"""
notify-telegram: Envía notificaciones a tu bot de Telegram desde la terminal o scripts.
Uso:
  notify-telegram "Mensaje a enviar"
  notify-telegram "Título" "Cuerpo del mensaje"
  echo "Salida de comando" | notify-telegram "Título"
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from notify_common import send_telegram  # noqa: E402


def main():
    args = sys.argv[1:]
    stdin_content = ""

    if not sys.stdin.isatty():
        try:
            stdin_content = sys.stdin.read().strip()
        except Exception:
            pass

    if len(args) == 0 and not stdin_content:
        print("Uso: notify-telegram [titulo] [mensaje]")
        print("      comando | notify-telegram [titulo]")
        sys.exit(1)

    if len(args) == 1:
        if stdin_content:
            title = args[0]
            message = f"🔔 *{title}*\n\n```\n{stdin_content[:3500]}\n```"
        else:
            message = f"🔔 {args[0]}"
    elif len(args) >= 2:
        title = args[0]
        body = " ".join(args[1:])
        if stdin_content:
            body += f"\n\n```\n{stdin_content[:3000]}\n```"
        message = f"🔔 *{title}*\n\n{body}"
    else:
        message = f"🔔 *Notificación de PC:*\n\n```\n{stdin_content[:3800]}\n```"

    success = send_telegram(message, timeout=10)
    sys.exit(0 if success else 1)


if __name__ == "__main__":
    main()
